{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sankarshanmukhopadhyay.github.io/agent-registry-protocol/schemas/agent-card-arpa-extension.schema.json",
  "title": "ARPA Agent Card Extension",
  "type": "object",
  "properties": {
    "extension_version": {
      "const": "1.0"
    },
    "arpa_profile": {
      "const": "https://arpa.example/profiles/a2a/1.0"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "pattern": "^agentreg:"
    },
    "description_digest": {
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "status_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "relationships_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "assurance_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "authority_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "governance_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "critical": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "events_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "conformance_endpoint": {
      "type": "string",
      "format": "uri"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "extension_version",
    "arpa_profile",
    "registry_id",
    "agent_id",
    "description_digest",
    "status_endpoint"
  ],
  "additionalProperties": false
}
